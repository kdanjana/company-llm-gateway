# Copy this file to .env and fill in the values. Never commit .env.

# --- Postgres (local Docker) ---
POSTGRES_DB=llm_gateway
POSTGRES_USER=llm_gateway
POSTGRES_PASSWORD=change-me-local-only
# Port on your laptop for DB tools (5433, so it does not clash with the Knowledge Hub project on 5432).
POSTGRES_HOST_PORT=5433

# --- Django ---
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=true

# --- Dashboard login (JWT) ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_HOURS=8

# --- AWS / Bedrock ---
AWS_REGION=ap-south-1
# Use an IAM user that may ONLY call Bedrock (bedrock:InvokeModel, bedrock:InvokeModelWithResponseStream).
# You can reuse the Bedrock-only user from the Knowledge Hub project.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials:
AWS_SESSION_TOKEN=
# Seconds to wait for the model's answer before giving up.
BEDROCK_READ_TIMEOUT=120

# --- Gateway ---
# Upper limit for max_tokens in one request (protects the bill from huge answers).
GATEWAY_MAX_TOKENS=4096
# Budget alert level in percent (a second alert is always created at 100%, when requests get blocked).
GATEWAY_BUDGET_ALERT_PERCENT=80
# How long an identical request may be answered from the cache, in seconds.
GATEWAY_CACHE_TTL_SECONDS=3600

# Fake model answers: no AWS calls, no cost. For the load test and UI demos. Only works with DJANGO_DEBUG=true.
GATEWAY_FAKE_BEDROCK=false
# Pretend the fake model takes this long (ms), to simulate a real model.
GATEWAY_FAKE_LATENCY_MS=0
